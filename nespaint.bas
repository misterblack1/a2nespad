20  REM  NES PAINT: lo-res paint driven by an NES pad
30  REM  on Apple II game port (controller 1 = PB2 line).
40  GOSUB 500
50  GR
60  CC = 15: GOSUB 400
70  CX = 20:CY = 20:UN = 0:PH = 1:QL = 0:QR = 0
80  GOSUB 430
90  CALL 768
100  AB = PEEK (960):BB = PEEK (961):SL = PEEK (962):SR = PEEK (963)
110  UP = PEEK (964):DN = PEEK (965):LF = PEEK (966):RT = PEEK (967)
120  NX = CX:NY = CY
130  IF LF THEN IF CX > 0 THEN NX = CX - 1
140  IF RT THEN IF CX < 39 THEN NX = CX + 1
150  IF UP THEN IF CY > 0 THEN NY = CY - 1
160  IF DN THEN IF CY < 39 THEN NY = CY + 1
170  IF NX = CX THEN IF NY = CY THEN 190
180  COLOR= UN: PLOT CX,CY:CX = NX:CY = NY:UN = SCRN( CX,CY)
190  IF AB THEN UN = CC
200  IF BB THEN UN = 0
210  IF SL THEN IF QL = 0 THEN CC = CC + 1: IF CC > 15 THEN CC = 0
220  IF SL THEN IF QL = 0 THEN GOSUB 400
230  QL = SL
240  IF SR THEN IF QR = 0 THEN GOSUB 460
250  QR = SR
260  IF PH THEN COLOR= CC
270  IF PH = 0 THEN COLOR= CB
280  PLOT CX,CY
290  PH = 1 - PH
300  FOR D = 1 TO 20: NEXT
310  GOTO 90
400  CB = 15: IF CC = 15 THEN CB = 0
410  VTAB 23: HTAB 1: PRINT "COLOR: ";CC;"   ";
420  RETURN
430  VTAB 21: HTAB 1: PRINT "MOVE=PAD  A=PAINT  B=ERASE    ";
440  VTAB 22: HTAB 1: PRINT "SELECT=COLOR  START=CLEAR     ";
450  GOSUB 400: RETURN
460  COLOR= 0: FOR Y = 0 TO 39: HLIN 0,39 AT Y: NEXT
470  UN = 0: RETURN
500  FOR I = 768 TO 799: READ B: POKE I,B: NEXT : RETURN
510  DATA 173,89,192,173,88,192,162,0,173,90,192
520  DATA 173,99,192,73,128,10,169,0,42,157
530  DATA 192,3,173,91,192,232,224,8,208,233,96
